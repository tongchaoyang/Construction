landmarkadu.com, ://landmarkadu.com {
    reverse_proxy backend:8080
}

# Local development: http://localhost (https://localhost uses Caddy's internal, self-signed cert)
http://localhost {
    reverse_proxy backend:8080
}

https://localhost {
    tls internal
    reverse_proxy backend:8080
}

# Send www to the main domain (keeps sign-in on the one hostname registered with Google)
www.landmarkadu.com {
    redir https://landmarkadu.com{uri} permanent
}
